{
  "name": "@docflow/worker",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "db:test:migrate": "dotenv -e .env.test -- pn --filter @docflow/database exec drizzle-kit migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/client-sqs": "^3.1095.0",
    "@docflow/aws": "workspace:*",
    "@docflow/config": "workspace:*",
    "@docflow/database": "workspace:*",
    "@docflow/events": "workspace:*",
    "@docflow/logger": "workspace:*",
    "@docflow/shared": "workspace:*",
    "dotenv": "^17.4.2",
    "pdf-parse": "^2.4.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-orm": "^0.45.2",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
