# Database
DATABASE_URL=postgres://docflow:docflow@localhost:5432/docflow

# AWS (Floci for local development)
S3_BUCKET=docflow-uploads
SQS_QUEUE_URL=http://localhost:4566/000000000000/docflow-document-processing
SNS_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:docflow-events
AWS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# API
PORT=3000
MAX_FILE_SIZE=10485760  # 10 MB in bytes

# CORS
CORS_ORIGINS=*  # Use comma-separated origins in production, e.g. "https://myapp.com,https://admin.myapp.com"

# Rate Limiting
RATE_LIMIT_MAX=100          # Max requests per window
RATE_LIMIT_WINDOW=15 seconds # Time window for rate limiting

# Logging
LOG_LEVEL=info
NODE_ENV=development
